{
  "name": "echoline",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @echoline/web dev",
    "dev:api": "pnpm --filter @echoline/api dev",
    "dev:worker": "pnpm --filter @echoline/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @echoline/db migrate",
    "db:seed": "pnpm --filter @echoline/db seed"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
