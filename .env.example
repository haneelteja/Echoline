# Supabase (Project Settings -> API / Database)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> Database -> Connection string (use the pooled "Transaction" URL for apps, direct URL for migrations)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Credential vault (Phase 2) - 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
CREDENTIAL_VAULT_MASTER_KEY=

# OAuth (Phase 2) - Gmail and Microsoft 365 provider connections.
# Leave unset to disable those two providers; API-key providers are unaffected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Public base URLs used to build OAuth redirect/callback links.
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=

# Sentry
SENTRY_DSN=

# apps/web
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# apps/api
PORT=4000

# Mailpit (local dev email)
SMTP_HOST=localhost
SMTP_PORT=1025
